rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return userDocExists() && userDoc().data.role == 'admin';
    }

    function hasPermission(p) {
      return isAdmin()
        || (
          userDocExists()
          && userDoc().data.role == 'supervisor'
          && userDoc().data.permissions is list
          && p in userDoc().data.permissions
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || hasPermission('members')
      );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == 'user'
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.permissions == resource.data.permissions
        );

      allow delete: if isAdmin();
    }

    match /news/{id} {
      allow read: if true;
      allow create, update, delete: if hasPermission('news');
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if hasPermission('events');
    }

    match /articles/{id} {
      allow read: if true;
      allow create, update, delete: if hasPermission('articles');
    }

    match /health/{id} {
      allow read: if true;
      allow create, update, delete: if hasPermission('health');
    }

    match /environment/{id} {
      allow read: if true;
      allow create, update, delete: if hasPermission('environment');
    }


    match /notifications/{id} {
      allow create: if hasPermission('news')
        || hasPermission('events')
        || hasPermission('articles')
        || hasPermission('health')
        || hasPermission('environment')
        || hasPermission('inquiries');
      allow read: if signedIn() && (
        resource.data.audience == 'all'
        || (resource.data.audience == 'user' && resource.data.userId == request.auth.uid)
        || hasPermission('inquiries')
      );
      allow update, delete: if hasPermission('inquiries');
    }

    match /inquiries/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if hasPermission('inquiries')
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow update: if hasPermission('inquiries')
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userSeen'])
          && request.resource.data.userSeen == true
        );

      allow delete: if hasPermission('inquiries');
    }
  }
}
