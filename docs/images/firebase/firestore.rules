rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return signedIn()
        && userDoc().data.role == 'admin';
    }

   function hasPermission(p) {
  return isAdmin()
    || (
      signedIn()
      && userDoc().data.role == 'supervisor'
      && p in userDoc().data.permissions
    );
}

    /* =========================
       المستخدمون
       ========================= */

    match /users/{uid} {

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || hasPermission('members')
          || isAdmin()
        );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == 'user'
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.permissions == resource.data.permissions
        );

      allow delete: if isAdmin();
    }


    /* =========================
       الأخبار
       ========================= */

    match /news/{id} {

      allow read: if true;

      allow create, update, delete:
        if hasPermission('news');
    }


    /* =========================
       الفعاليات
       ========================= */

    match /events/{id} {

      allow read: if true;

      allow create, update, delete:
        if hasPermission('events');
    }


    /* =========================
       المقالات
       ========================= */

    match /articles/{id} {

      allow read: if true;

      allow create, update, delete:
        if hasPermission('articles');
    }


    /* =========================
       الصحة
       ========================= */

    match /health/{id} {

      allow read: if true;

      allow create, update, delete:
        if hasPermission('health');
    }


    /* =========================
       البيئة
       ========================= */

    match /environment/{id} {

      allow read: if true;

      allow create, update, delete:
        if hasPermission('environment');
    }


    /* =========================
       استفسارات المواطنين
       ========================= */

    match /inquiries/{id} {

      /* العضو يستطيع إرسال استفساره */
      allow create:
        if signedIn()
        && request.resource.data.userId == request.auth.uid;


      /* الإدارة ترى كل الاستفسارات،
         والعضو يرى استفساراته فقط */
      allow read:
        if hasPermission('inquiries')
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );


      /* الإدارة تستطيع الرد والتعديل،
         والعضو يستطيع فقط وضع userSeen = true */
      allow update:
        if hasPermission('inquiries')
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data
               .diff(resource.data)
               .affectedKeys()
               .hasOnly(['userSeen'])
          && request.resource.data.userSeen == true
        );


      /* حذف الاستفسارات للإدارة فقط */
      allow delete:
        if hasPermission('inquiries');
    }
  }
}